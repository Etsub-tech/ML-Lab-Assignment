    "#  PART E: Vectors and Dot Product \n",
    "\n",
    "# 1. Select one student row (features only) as vector x\n",
    "# Features are: study_hours, attendance, previous_mark\n",
    "x = df[['study_hours', 'attendance', 'previous_mark']].iloc[0].values\n",
    "\n",
    "# 2. Define weight vector w and bias b\n",
    "w = np.array([0.5, 0.2, 0.4])\n",
    "b = 5\n",
    "\n",
    "# 3. Calculate y = w . x + b using NumPy dot product\n",
    "y_pred = np.dot(w, x) + b\n",
    "print(f\"Feature Vector x: {x}\")\n",
    "print(f\"Calculated Prediction y: {y_pred:.2f}\")"
   ]
