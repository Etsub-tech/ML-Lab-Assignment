   "source": [
    "# PART A: Inspect and Clean \n",
    "\n",
    "# 1. missing values we have in each column\n",
    "print(\"- Missing Values Check\")\n",
    "print(df.isnull().sum())\n",
    "\n",
    "# fixing the missing values with median\n",
    "median_study = df['study_hours'].median()\n",
    "df['study_hours'] = df['study_hours'].fillna(median_study)\n",
    "\n",
    "# Fix the outlier: If study_hours is unrealistically high (> 20 hours), replace it with the median\n",
    "df.loc[df['study_hours'] > 20, 'study_hours'] = median_study\n",
    "\n",
    "# Fix the impossible negative attendance (-10) by replacing it with the median attendance\n",
    "median_attendance = df['attendance'][df['attendance'] >= 0].median()\n",
    "df.loc[df['attendance'] < 0, 'attendance'] = median_attendance\n",
    "\n",
    "print(\"\\n - After Cleaning\")\n",
    "print(\"Missing values now:\", df.isnull().sum().sum()) # Should be 0\n",
    "\n",
    "# 2. Check the shape of our dataset\n",
    "print(\"\\n - Dataset Shape \")\n",
    "print(\"Shape (Rows, Columns):\", df.shape)"
   ]
